  # Create interface connections
  connect_bd_intf_net -intf_net Conn2 [get_bd_intf_pins axi_dma_0/S_AXI_LITE] [get_bd_intf_pins S_AXI_DMA]
  connect_bd_intf_net -intf_net Conn3 [get_bd_intf_pins axis_data_fifo_0/S_AXIS] [get_bd_intf_pins S_AXIS]
  connect_bd_intf_net -intf_net Conn4 [get_bd_intf_pins axis_data_fifo_1/M_AXIS] [get_bd_intf_pins M_AXIS]
